# secret.yaml.example — TEMPLATE ONLY. Copy to secret.yaml on the bank VM,
# fill in real values, and apply it there. secret.yaml itself (with real
# secrets) must NEVER be committed — see .gitignore.
#
# Plain Kubernetes Secrets are base64, not encrypted at rest by default on
# most on-prem clusters. This is a KNOWN, ACKNOWLEDGED GAP — the "secrets
# manager" initiative (4th in the roadmap order) replaces this. Do not
# treat this file as a real secrets-management solution.
apiVersion: v1
kind: Secret
metadata:
  name: attijari-secrets
  namespace: attijari
type: Opaque
stringData:
  DATABASE_URL: "postgresql://attijari_user:CHANGE_ME@postgres:5432/attijari_db"
  POSTGRES_PASSWORD: "CHANGE_ME"
  VAULT_ENCRYPTION_KEY: "CHANGE_ME_run_python_-c_from_cryptography.fernet_import_Fernet_print_Fernet.generate_key"
  JWT_SECRET: "CHANGE_ME_32_bytes_minimum_different_from_VAULT_ENCRYPTION_KEY"
  DASHBOARD_PASS: "CHANGE_ME_or_leave_blank_for_a_random_generated_admin_password"
