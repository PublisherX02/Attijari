# ==================================================================
# Attijari Email Triage — Environment Variables
# ==================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==================================================================

# --- IMAP ---
# The pipeline itself no longer reads this directly (see Inbound SMTP below).
# Still used by src/gmail_smtp_bridge.py, which polls this Gmail account and
# relays real mail into the local SMTP receiver — see GMAIL_BRIDGE_* below.
IMAP_HOST=imap.gmail.com
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Inbound SMTP (email ingestion — replaces IMAP polling) ---
# Local demo: leave host/port as-is, send test mail with swaks or smtplib
# to localhost:2525. Real deployment: point the domain's MX record here,
# set SMTP_INBOUND_LISTEN_HOST=0.0.0.0, SMTP_INBOUND_LISTEN_PORT=25 (or 587),
# and set SMTP_INBOUND_ACCEPTED_DOMAINS to the real domain(s) so the server
# is never an open relay.
SMTP_INBOUND_LISTEN_HOST=127.0.0.1
SMTP_INBOUND_LISTEN_PORT=2525
# Comma-separated. Empty = accept mail for any recipient domain (demo only).
SMTP_INBOUND_ACCEPTED_DOMAINS=
SMTP_INBOUND_MAX_MESSAGE_SIZE=26214400
# Optional STARTTLS — leave both empty to run without TLS (fine for local demo).
SMTP_INBOUND_TLS_CERT_PATH=
SMTP_INBOUND_TLS_KEY_PATH=

# --- Gmail -> SMTP bridge (personal-email demo path) ---
# Plays the role of "the internet" in the SMTP ingestion spec: polls the
# IMAP account above and relays each message into the inbound SMTP receiver,
# so real Gmail mail still reaches the pipeline without changing how the
# pipeline itself ingests mail. Set GMAIL_BRIDGE_ENABLED=0 to disable and
# rely purely on swaks/smtplib test injection instead.
GMAIL_BRIDGE_ENABLED=1
GMAIL_BRIDGE_INTERVAL_SECONDS=60
# Recipient address used on the relay hop — must satisfy
# SMTP_INBOUND_ACCEPTED_DOMAINS if that's set. Defaults to IMAP_USER.
GMAIL_BRIDGE_RCPT_TO=

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/attijari_db

# --- Threat Intelligence API Keys ---
VIRUSTOTAL_API_KEY=
THREATFOX_AUTH_KEY=
AbuseIPDB_API_KEY=

# --- dnstwist (dnstwister.report API config, JSON format) ---
# Get API endpoints from: https://dnstwister.report/api/
DNSTWIST_API_KEY={"domain_fuzzer_url":"https://dnstwister.report/api/fuzz/{domain_as_hexadecimal}","domain_to_hexadecimal_url":"https://dnstwister.report/api/to_hex/{domain}","has_mx_url":"https://dnstwister.report/api/mx/{domain_as_hexadecimal}","ip_resolution_url":"https://dnstwister.report/api/ip/{domain_as_hexadecimal}","parked_check_url":"https://dnstwister.report/api/parked/{domain_as_hexadecimal}","url":"https://dnstwister.report/api/","whois_url":"https://dnstwister.report/api/whois/{domain_as_hexadecimal}"}

# --- AlienVault OTX (optional — enrichment) ---
OTX_API_KEY=

# --- LLM Model (Ollama, default: gemma3:4b) ---
# LLM_MODEL=gemma3:4b

# --- Quarantine Vault ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_ENCRYPTION_KEY=

# --- JWT Signing (MUST differ from VAULT_ENCRYPTION_KEY) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# --- Reporting (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
REPORT_RECIPIENTS=analyst@example.com

# --- Reporting (Webhooks, optional) ---
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# --- Scheduler ---
POLL_INTERVAL_SECONDS=60
FEED_UPDATE_CRON=0 3 * * *
REPORT_CRON=0 8 * * *

# --- Dashboard ---
# Loopback by default — the dashboard is plain HTTP and must NOT bind all
# interfaces. For remote access, put a TLS-terminating reverse proxy in front
# rather than setting this to 0.0.0.0.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
# Comma-separated proxies allowed to set X-Forwarded-For (client-IP / rate
# limiting). Leave as the loopback proxy unless you front the app with one.
TRUSTED_PROXIES=127.0.0.1

# --- Auto-release threshold (0.0-1.0) ---
AUTO_RELEASE_CONFIDENCE=0.85

# --- NVIDIA Model-Specific Keys ---
NVIDIA_MISTRAL_KEY=

# ==================================================================
# Detonation sandbox (CAPEv2) — memory-gated behavioral analysis
# ==================================================================
# CAPE runs on a SEPARATE Ubuntu VM (KVM). The host only talks to its REST API.
CAPE_API_URL=http://192.168.56.10:8000/apiv2
CAPE_API_TOKEN=
# Set to 0 for a self-signed lab cert
CAPE_VERIFY_TLS=1

# malscore (0-10) mapping
CAPE_MALSCORE_ESCALATE=6.0
CAPE_MALSCORE_SUSPICIOUS=3.0

# Timeouts (seconds)
CAPE_ANALYSIS_TIMEOUT=180
CAPE_TOTAL_TIMEOUT=600
DETONATION_CYCLE_TIMEOUT=1800
DETONATION_BATCH_SIZE=5

# --- Memory management during a detonation window (Windows host commands) ---
# Each step can be toggled; commands are tuned to YOUR setup.
DETONATION_UNLOAD_OLLAMA=1
DETONATION_FREE_GUARD=1
DETONATION_STOP_DOCKER=1
DETONATION_MANAGE_VM=1
OLLAMA_BASE_URL=http://localhost:11434
# `wsl --shutdown` frees the Docker WSL2 backend (~2 GB). It stops ALL WSL2.
DOCKER_STOP_CMD=wsl --shutdown
DOCKER_START_CMD="C:\Program Files\Docker\Docker\Docker Desktop.exe"
# CAPE Ubuntu VM lifecycle. Defaults below are Hyper-V (recommended with WSL2).
# VirtualBox alternative:
#   VM_RESUME_CMD=VBoxManage controlvm cape-ubuntu resume
#   VM_SUSPEND_CMD=VBoxManage controlvm cape-ubuntu savestate
CAPE_VM_NAME=cape-ubuntu

# --- CAPE dashboard integration (sandbox viewing / cuckoo2 recovery) ---
# Enable only after executing docs/sandbox-setup.md on the imania VM
CAPE_VM_WRAPPER_ENABLED=0
CAPE_VM_WRAPPER_URL=http://192.168.100.10:8090
CAPE_VM_WRAPPER_TOKEN=
CAPE_VM_WRAPPER_TIMEOUT=20
WEBSOCKIFY_URL=ws://192.168.100.10:6080
# CAPE_WEB_URL defaults to CAPE_API_URL without /apiv2 — set only to override
#CAPE_WEB_URL=http://192.168.100.10:8000
